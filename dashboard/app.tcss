/* Dark, bordered-panel theme shared by every screen in the dashboard. */

Screen {
    background: $surface;
}

/* Every screen centers a single fixed-width panel in the middle of the
   terminal; .screen-root is the full-size aligner, .panel is the content
   box itself. */
.screen-root {
    align: center middle;
    width: 100%;
    height: 100%;
}

.panel {
    width: 74;
    height: auto;
    max-height: 90%;
    border: heavy $primary;
    padding: 1 3;
    background: $panel;
}

#screen-title {
    text-style: bold;
    text-align: center;
    color: $text-accent;
    padding: 0 0 1 0;
}

/* --- Home screen --- */

#home {
    padding: 1 2;
    height: 100%;
}

#home-shell {
    width: 100%;
    height: 100%;
    layout: vertical;
}

#home-header {
    width: 100%;
    height: auto;
    align: center middle;
}

#home-logo {
    text-align: center;
    color: $primary-lighten-2;
}

#home-title {
    text-align: center;
    text-style: bold;
    color: $text-accent;
}

#home-subtitle {
    text-align: center;
    color: $text-muted;
}

/* The dashboard body defaults to a single stacked column; on_resize adds
   .layout-wide (>= _WIDE_BREAKPOINT columns) for a 2x2 grid instead, or
   .layout-narrow explicitly for the stacked form -- both driven from
   Python, never from a CSS media query (Textual has none). Panels use
   height: 1fr (not auto) so, stacked or gridded, all four always evenly
   share whatever vertical space is actually available -- each panel's own
   OptionList/VerticalScroll then scrolls internally if its content is
   taller than that share, rather than the panel overflowing the screen. */
#home-dashboard {
    width: 100%;
    height: 1fr;
    layout: vertical;
    padding: 1 0 0 0;
}

#home-dashboard.layout-wide {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 1fr;
}

.home-panel {
    border: round $primary;
    background: $panel-darken-1;
    padding: 1 2;
    height: 1fr;
    margin: 0 0 1 0;
}

#home-dashboard.layout-wide .home-panel {
    margin: 0;
}

/* The "compact" class comes from the user's Settings preference (layout
   density), independent of the wide/narrow class above (terminal width). */
#home-dashboard.compact .home-panel {
    padding: 0 1;
}

.panel-heading {
    text-style: bold;
    color: $text-accent;
    padding: 0 0 1 0;
}

#home-dashboard.compact .panel-heading {
    padding: 0;
}

#main-menu,
#recent-projects-list,
#active-sessions-list {
    height: 1fr;
    max-height: 100%;
    margin: 0;
    border: none;
    background: transparent;
}

#system-status-scroll {
    height: 1fr;
}

#system-status-body {
    color: $text-muted;
    height: auto;
}

/* --- Shared list / input styling --- */

OptionList {
    height: auto;
    max-height: 14;
    margin: 1 0 0 0;
    border: round $primary;
    background: $panel-darken-1;
}

OptionList:focus {
    border: round $accent;
}

Input {
    margin: 1 0 0 0;
    border: round $primary;
}

Input:focus {
    border: round $accent;
}

/* --- Projects screen --- */

#project-path {
    padding: 1 0 0 0;
    color: $text-muted;
}

/* --- tmux screen --- */

#tmux-status {
    padding: 0 0 1 0;
    color: $text-muted;
}

/* --- System info screen --- */

#info-rows {
    height: auto;
    border: round $primary;
    background: $panel-darken-1;
    padding: 1 2;
}

.info-row {
    padding: 0 1;
}

/* --- Placeholder screens --- */

#placeholder-body {
    text-align: center;
    padding: 1 0;
    color: $text-muted;
}

/* --- New Project wizard --- */

.field-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

#wizard-error {
    color: $error;
    padding: 1 0 0 0;
    text-align: center;
}

.wizard-hint {
    color: $text-muted;
    padding: 0 0 1 0;
}

.button-row {
    height: auto;
    padding: 1 0 0 0;
    align: center middle;
}

.button-row Button {
    margin: 0 1;
}

#custom-command-fields {
    height: auto;
    border: round $primary;
    background: $panel-darken-1;
    padding: 1 1 0 1;
    margin: 1 0 0 0;
}

SelectionList {
    height: auto;
    max-height: 10;
    margin: 1 0 0 0;
    border: round $primary;
    background: $panel-darken-1;
}

SelectionList:focus {
    border: round $accent;
}

.preview-grid {
    background: $panel-darken-1;
    border: round $primary;
    padding: 0 1;
    margin: 1 0;
    color: $text-accent;
}

#destination-preview {
    color: $text-muted;
    padding: 1 0 0 0;
}

/* --- Settings screen --- */

Checkbox {
    margin: 1 0 0 0;
}

/* --- Confirm dialog --- */

ConfirmScreen {
    align: center middle;
}

#confirm-panel {
    width: 60;
    height: auto;
    border: heavy $error;
    padding: 1 3;
    background: $panel;
}

#template-name-panel {
    width: 60;
    height: auto;
    max-height: 14;
    padding: 1 2;
}

#confirm-message {
    text-align: center;
}

/* --- Project Detail screen --- */

#detail-path,
#detail-git,
#detail-workspace,
#detail-session {
    color: $text-muted;
}

#detail-error {
    color: $error;
    padding: 1 0 0 0;
    text-align: center;
}

#detail-missing-dir,
#detail-metadata-error,
#detail-no-actions {
    color: $warning;
    padding: 1 0 0 0;
}
