/* Terminal-native styling shared by every screen in the dashboard. */

Screen {
    background: transparent;
}

/* Textual 8.x supports scrollbar-size as horizontal vertical. Keep genuine
   long-form screens usable without letting the scrollbar dominate split
   terminals; containers that fit content do not render one. */
VerticalScroll, OptionList {
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: $text-muted;
    scrollbar-color-hover: $text-accent;
    scrollbar-color-active: $text-accent;
    scrollbar-corner-color: transparent;
}

OptionList {
    scrollbar-size: 1 1;
    height: auto;
    max-height: 100%;
    overflow-x: hidden;
}

.tmux-session-list {
    min-height: 1;
    height: auto;
}

/* Every screen centers a single fixed-width panel in the middle of the
   terminal; .screen-root is the full-size aligner, .panel is the content
   box itself. */
.screen-root {
    align: center top;
    width: 100%;
    height: auto;
    padding: 1 2;
}

.panel {
    width: 74;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    border: solid #30445f;
    padding: 1 3;
    background: transparent;
}

/* System Information needs a little more value-column room than ordinary
   panels, but remains bounded by the screen and its outer scroll container. */
.panel.system-info-panel {
    width: 94;
    max-width: 100%;
}

/* System Information owns the available area above Footer. Its content is
   allowed to scroll on short terminals instead of being clipped by the
   shared panel cap. */
.system-info-scroll {
    height: 1fr;
    max-height: 100%;
    overflow-y: auto;
}

.system-info-panel {
    max-height: 100%;
}

#screen-title {
    text-style: bold;
    text-align: center;
    color: $text-accent;
    padding: 0 0 1 0;
}

/* --- Home screen --- */

#home {
    padding: 1 2;
    height: auto;
}

#home-shell {
    width: 100%;
    height: auto;
    layout: vertical;
}

#home-header {
    width: 100%;
    height: auto;
    align: left top;
    padding: 0 0 1 0;
}

#home-logo {
    text-align: left;
    color: $primary-lighten-2;
}

#home-meta {
    text-align: left;
    color: $text-muted;
    max-width: 100%;
}

/* The dashboard body defaults to a single stacked column; on_resize adds
   .layout-wide (>= _WIDE_BREAKPOINT columns) for a 2x2 grid instead, or
   .layout-narrow explicitly for the stacked form -- both driven from
   Python, never from a CSS media query (Textual has none). Panels use
   Both layouts remain content-sized so short lists do not create empty
   terminal-sized panels. */
#home-dashboard {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 0;
}

#home-dashboard.layout-wide {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 2;
    grid-rows: auto auto;
    align: left top;
    height: auto;
}

#panel-sessions {
    column-span: 2;
}

.home-panel {
    border-bottom: solid #30445f;
    background: transparent;
    padding: 0 1 1 1;
    height: auto;
    margin: 0 0 1 0;
}

#home-dashboard.layout-wide .home-panel {
    margin: 0;
    height: 100%;
}

#home-dashboard.layout-narrow .home-panel {
    height: auto;
}

/* The "compact" class comes from the user's Settings preference (layout
   density), independent of the wide/narrow class above (terminal width). */
#home-dashboard.compact .home-panel {
    padding: 0 1;
}

.panel-heading {
    text-style: bold;
    color: $text-accent;
    padding: 0 0 0 0;
}

.home-panel.active-section {
    border-bottom: solid #55d6ff;
    background: transparent;
}

#home-dashboard.compact .panel-heading {
    padding: 0;
}

#main-menu,
#recent-projects-list,
#active-sessions-list {
    height: auto;
    margin: 0;
    border: none;
    background: transparent;
    border: none;
}

/* Home lists are bounded content, not nested scrolling panels. */
#home-dashboard OptionList {
    height: auto;
    margin: 0;
}

#home-dashboard OptionList > .option-list--option-highlighted {
    color: #72d7ff;
    background: transparent;
    text-style: bold;
}

#home-dashboard OptionList:focus {
    background: transparent;
    border: none;
}

#main-menu {
    height: auto;
    max-height: 9;
}

#keyboard-footer {
    color: #b5c8df;
    background: transparent;
    text-align: center;
    height: 1;
}

/* --- Shared list / input styling --- */

OptionList {
    height: auto;
    max-height: 14;
    margin: 1 0 0 0;
    border: round $primary;
    background: transparent;
}

OptionList:focus {
    border: round $accent;
}

Input {
    margin: 1 0 0 0;
    border: round $primary;
}

Input:focus {
    border: round $accent;
}

/* --- Projects screen --- */

#project-path {
    padding: 1 0 0 0;
    color: $text-muted;
}

/* --- tmux screen --- */

#tmux-status {
    padding: 0 0 1 0;
    color: $text-muted;
}

/* --- System info screen --- */

#info-rows {
    height: auto;
    width: 100%;
    grid-size: 2;
    grid-columns: 20 1fr;
    grid-rows: auto;
    border: round $primary;
    background: transparent;
    padding: 1 2;
}

.info-label {
    height: auto;
    color: $text-muted;
}

.info-value {
    min-width: 0;
    height: auto;
    text-wrap: wrap;
}

/* --- Placeholder screens --- */

#placeholder-body {
    text-align: center;
    padding: 1 0;
    color: $text-muted;
}

/* --- New Project wizard --- */

.field-label {
    color: $text-muted;
    padding: 1 0 0 0;
}

#wizard-error {
    color: $error;
    padding: 1 0 0 0;
    text-align: center;
}

.wizard-hint {
    color: $text-muted;
    padding: 0 0 1 0;
}

.button-row {
    height: auto;
    padding: 1 0 0 0;
    align: center middle;
}

.button-row Button {
    margin: 0 1;
}

#custom-command-fields {
    height: auto;
    border: round $primary;
    background: transparent;
    padding: 1 1 0 1;
    margin: 1 0 0 0;
}

SelectionList {
    height: auto;
    max-height: 10;
    margin: 1 0 0 0;
    border: round $primary;
    background: transparent;
}

SelectionList:focus {
    border: round $accent;
}

.preview-grid {
    background: transparent;
    border: round $primary;
    padding: 0 1;
    margin: 1 0;
    color: $text-accent;
}

#destination-preview {
    color: $text-muted;
    padding: 1 0 0 0;
}

/* --- Settings screen --- */

Checkbox {
    margin: 1 0 0 0;
}

CircularCheckbox {
    margin: 1 0 0 0;
    padding: 0;
    background: transparent;
    border: none;
}

CircularSelectionList {
    height: auto;
    max-height: 10;
    border: round $primary;
    background: transparent;
}

CircularSelectionList:focus {
    border: round $accent;
}

/* --- Confirm dialog --- */

ConfirmScreen {
    align: center middle;
}

#confirm-panel {
    width: 60;
    height: auto;
    border: heavy $error;
    padding: 1 3;
    background: transparent;
}

#template-name-panel {
    width: 60;
    height: auto;
    max-height: 14;
    padding: 1 2;
}

#template-path-panel {
    width: 76;
    height: auto;
    max-height: 14;
    padding: 1 2;
}

#template-import-review-panel {
    width: 84;
    height: 80%;
    padding: 1 2;
}

#confirm-message {
    text-align: center;
}

/* --- Project Detail screen --- */

#detail-path,
#detail-git,
#detail-workspace,
#detail-session {
    color: $text-muted;
}

#detail-error {
    color: $error;
    padding: 1 0 0 0;
    text-align: center;
}

#detail-missing-dir,
#detail-metadata-error,
#detail-no-actions {
    color: $warning;
    padding: 1 0 0 0;
}

/* Shared visual and focus treatment. */
Screen {
    background: transparent;
    color: #e6edf7;
}

.panel {
    width: 1fr;
    max-width: 86;
    max-height: 94%;
    border: solid #30445f;
    padding: 1 2;
    background: transparent;
}

#screen-title, .panel-heading {
    color: #72d7ff;
}

OptionList, SelectionList {
    border: solid #30445f;
    background: transparent;
}

OptionList:focus, SelectionList:focus, Input:focus, Checkbox:focus, Button:focus {
    border: double #55d6ff;
    background-tint: transparent;
}

/* The three Settings choice groups share one focus treatment and geometry. */
.settings-choice-group {
    width: 100%;
    max-width: 100%;
    min-height: 3;
    height: auto;
    margin: 1 0;
    padding: 0 1;
    border: solid #30445f;
    background: transparent;
}

.settings-choice-group:focus {
    border: round #9b8cff;
    background: transparent;
}

.settings-choice-group RadioButton,
.settings-choice-group CircularSelectionList {
    width: 100%;
    padding: 0;
    margin: 0;
}

.settings-choice-group RadioButton.-on > .toggle--button,
.settings-choice-group CircularSelectionList > .selection-list--button-selected {
    color: #9b8cff;
    background: transparent;
}

KeyboardActionList {
    height: auto;
    min-height: 0;
    padding: 0;
    background: transparent;
}

KeyboardActionList:focus {
    background: transparent;
    border: none;
}

#project-actions:focus,
#confirm-actions:focus,
#settings-actions:focus {
    background: transparent;
}

/* Keep Settings-specific purple styling last so native widget defaults cannot
   restore their blue or green focus/selection accents. */
SettingsScreen .settings-choice-group:focus {
    border: round #9b8cff;
    background: transparent;
}

#appearance-settings:focus,
#coding-agent-set:focus,
#table-header-color-set:focus {
    border: round #9b8cff;
    background: transparent;
}

SettingsScreen .settings-choice-group RadioButton.-on > .toggle--button,
SettingsScreen .settings-choice-group CircularSelectionList > .selection-list--button-selected {
    color: #9b8cff;
    background: transparent;
}

Button {
    min-width: 12;
    border: solid #38506d;
    background: transparent;
    color: #e6edf7;
}

Button:hover, Button:focus {
    background: transparent;
    color: #ffffff;
}

Button.-primary {
    background: transparent;
    color: #ffffff;
}

Button.-error {
    background: transparent;
    color: #ffffff;
}

Footer {
    background: transparent;
    color: #b5c8df;
}

#help-panel {
    width: 72;
    max-width: 94%;
    max-height: 90%;
    border: solid #55d6ff;
}

#help-title {
    color: #72d7ff;
    text-style: bold;
    padding-bottom: 1;
}

#help-body {
    color: #d4e2f2;
    padding-bottom: 1;
}

KeyboardOptionList:focus {
    border: double #55d6ff;
}

/* Final Settings override: keep native RadioSet and custom multi-select
   focus/selection accents identical. */
SettingsScreen .settings-choice-group:focus {
    border: round #9b8cff;
    background: transparent;
}

SettingsScreen .settings-choice-group RadioButton.-on > .toggle--button,
SettingsScreen .settings-choice-group CircularSelectionList > .selection-list--button-selected {
    color: #9b8cff;
    background: transparent;
}
